# Copy to backend/.env and fill in. Never commit the real .env.
DATABASE_URL=postgresql+psycopg://opspilot:opspilot@localhost:5433/opspilot
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
LLM_MODE=live
LLM_BASE_URL=https://api.groq.com/openai/v1/
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Gemini alternative: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-3.5-flash
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
# Reasoning models only (gpt-oss): low|medium|high. Leave empty for Gemini.
LLM_REASONING_EFFORT=low
CONFIDENCE_AUTO_THRESHOLD=0.80
CONFIDENCE_BLOCK_THRESHOLD=0.50
APPROVAL_DEFAULT_TIMEOUT_MINUTES=60
SCHEDULER_INTERVAL_SECONDS=30
SCHEDULER_ENABLED=true
SEED_ON_STARTUP=true
CORS_ORIGINS=http://localhost:5173
WEBHOOK_SECRET=change-me-webhook-secret
LOG_LEVEL=INFO
